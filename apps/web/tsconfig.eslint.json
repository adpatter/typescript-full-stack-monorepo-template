{
  "compilerOptions": {
    "noImplicitAny": true,
    "allowJs": true,
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "noEmit": true,
    "strict": true,
    "types": ["node"],
    "checkJs": true,
    "baseUrl": "."
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
