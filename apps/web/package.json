{
  "name": "web",
  "version": "1.0.0",
  "description": "Typescript Full-stack Monorepo Template Web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "lint": "eslint \"src/**/*\" \"eslint.config.js\" \"webpack.config.js\" \"scripts/**/*.js\"",
    "format": "prettier --write .",
    "format:lint": "npm run format && npm run lint",
    "clean": "rm -rf ./dist/*",
    "build": "webpack --mode production --config webpack.config.js && node ./scripts/copy-static.js",
    "clean:build": "npm run clean && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adamjpatterson/typescript-full-stack-monorepo-template.git"
  },
  "keywords": [],
  "author": "",
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^6.0.1"
  }
}
