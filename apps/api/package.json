{
  "name": "api",
  "version": "1.0.0",
  "description": "Typescript Full-stack Monorepo Template API",
  "main": "./dist/main.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "clean": "rm -rf ./dist/*",
    "build": "tsc --build .",
    "clean:build": "npm run clean && npm run build",
    "lint": "eslint \"src/**/*\" \"eslint.config.js\"",
    "format": "prettier --write .",
    "format:lint": "npm run format && npm run lint",
    "watch": "tsc --watch",
    "start": "node  --env-file=../../.env --expose-gc --trace-warnings ./dist/main.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adamjpatterson/typescript-full-stack-monorepo-template.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
